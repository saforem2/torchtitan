#!/bin/bash --login
#PBS -A AuroraGPT
#PBS -N followup-umbrella-boost-20261020
#PBS -l walltime=12:00:00
#PBS -l filesystems=home:flare
#PBS -q prod
#PBS -j oe
# select= overridden via qsub -l select=N
#   default: select=788 (512+256 active, 10 spares/seat); not boost eligible.
#   MULTI_ONLY=0,1 (default); add optional 2B seat explicitly with 0,1,2.

# Required per selected seat: WORKDIR_20B512/WORKDIR_20B256/WORKDIR_2B
# (separately pinned, position-patched checkout), INITIAL_LOAD_* (absolute DCP
# step with .metadata). Optional EXPECTED_HEAD_* pins each checkout exactly;
# EXPECTED_HEAD pins this submission repo; EXPECTED_PARENT checks its ancestry.
# CLI_DIALECT=legacy (production batch/seq flags) or tokens (newer source only).
# DRY_RUN=1 validates source, checkpoint seed, allocation and disjoint slices,
# then exits before checkpoint mkdir, archive broadcast, or hardware probes.

set -o pipefail
ulimit -c 0

# ── Source identity guard ──────────────────────────────────────────────
EXPECTED_PARENT="${EXPECTED_PARENT:-a0a4ed9b3c}"
# Optional immutable checkout pin supplied by the submission wrapper. No self-hash.
EXPECTED_HEAD="${EXPECTED_HEAD:-}"

REPO="${REPO:-/lus/flare/projects/AuroraGPT/foremans/projects/saforem2/torchtitan-ezpz}"
cd "$REPO" || { echo "FATAL: REPO not found: $REPO"; exit 1; }

HEAD_SHA="$(git rev-parse HEAD)"
if ! git merge-base --is-ancestor "$EXPECTED_PARENT" HEAD 2>/dev/null; then
  echo "FATAL: HEAD $HEAD_SHA does not contain EXPECTED_PARENT $EXPECTED_PARENT"
  echo "  (submission checkout ancestry differs; do not rebuild the pinned runtime)"
  exit 1
fi
if [[ -n "$EXPECTED_HEAD" && "$HEAD_SHA" != "$EXPECTED_HEAD" ]]; then
  echo "FATAL: HEAD $HEAD_SHA does not match EXPECTED_HEAD $EXPECTED_HEAD"
  exit 16
fi
echo "Source guard OK: HEAD=$HEAD_SHA contains $EXPECTED_PARENT"

# ── Resume position (samples, not tokens) — Option B: first-unseen + 5% margin, ceil to GBS ──
# Base: 1200*12288=14745600 (512N), 1550*6144=9523200 (256N)
# +5% exact: 15482880 (=1260*12288), 9999360 (=1627.5*6144)
# Verified GBS-aligned ceil: 15482880 (exact), 10002432 (=1628*6144)
# tokens = samples * 8192 (seq_len)
RESUME_SAMPLES_20B512=15482880
RESUME_SAMPLES_20B256=10002432

# ── Checkpoint dirs (fork, don't overwrite) ────────────────────────────
CKPT_20B512_SRC="outputs/checkpoints/agpt-20b-sophiag-olmo-mix-1124-n512-gbs12288-constlr-from9000"
CKPT_20B512_NEW="outputs/checkpoints/agpt-20b-sophiag-olmo-mix-1124-n512-gbs12288-constlr-from9000-fixedpos"
CKPT_20B256_SRC="outputs/checkpoints/agpt-20b-sophiag-olmo-mix-1124-n256-gbs6144"
CKPT_20B256_NEW="outputs/checkpoints/agpt-20b-sophiag-olmo-mix-1124-n256-gbs6144-fixedpos"
CKPT_2B_RECLAIM="outputs/checkpoints/agpt-2b-v2-512-reclaim-20261020"

# ---- Common env ----
export ZE_FLAT_DEVICE_HIERARCHY=FLAT CCL_PROCESS_LAUNCHER=pmix CCL_OP_SYNC=1
export ONEAPI_DEVICE_SELECTOR="opencl:gpu;level_zero:gpu" TORCH_CPP_LOG_LEVEL=ERROR
export http_proxy="${http_proxy:-http://proxy.alcf.anl.gov:3128}"
export https_proxy="${https_proxy:-http://proxy.alcf.anl.gov:3128}"

RUNS="/flare/AuroraGPT/foremans/runs"
SEQ_LEN=8192
LBS=2; GAS=1
TP=1; PP=1; CP=1
OPTIMIZER="sophiag"
LR="2.28e-5"
DECAY_RATIO="0.0"
MIN_LR_FACTOR="1.0"
TRAIN_TOKENS="4673780159710"
PPN="${NGPU_PER_HOST:-12}"
IDLE_TIMEOUT="${IDLE_TIMEOUT:-1800}"
CKPT_INTERVAL="${CKPT_INTERVAL:-100}"

SPARES="${SPARES:-10}"
# ---- Trainer table (REAL config names via CONFIG_SUFFIX pattern) ----
# Config names follow submit_agpt_multi_autoretry.sh: agpt_${MODEL}${CONFIG_SUFFIX}
# where MODEL=20b/2b and CONFIG_SUFFIX=_real (cos_sin RoPE). NOT agpt_20b_n512.
#  Format: model|nnodes|port|workdir|ckpt|dfl_name|lr|init_load|decay|minlr|tokens|spares|resume_samples|gbs
#  resume_samples is consumed via BLENDCORPUS_RESUME_CONSUMED_SAMPLES env (mpiexec --envall)
TRAINERS=(
  "20b|512|29500|${WORKDIR_20B512:-}|${REPO}/${CKPT_20B512_NEW}|olmo-mix-1124|${LR}|${INITIAL_LOAD_20B512:-}|${DECAY_RATIO}|${MIN_LR_FACTOR}|${TRAIN_TOKENS}|${SPARES}|${RESUME_SAMPLES_20B512}|12288"
  "20b|256|29600|${WORKDIR_20B256:-}|${REPO}/${CKPT_20B256_NEW}|olmo-mix-1124|${LR}|${INITIAL_LOAD_20B256:-}|${DECAY_RATIO}|${MIN_LR_FACTOR}|${TRAIN_TOKENS}|${SPARES}|${RESUME_SAMPLES_20B256}|6144"
  "2b|512|29700|${WORKDIR_2B:-}|${REPO}/${CKPT_2B_RECLAIM}|olmo-mix-1124|${LR}|${INITIAL_LOAD_2B:-}|${DECAY_RATIO}|${MIN_LR_FACTOR}|${TRAIN_TOKENS}|${SPARES}|0|12288"
)

# Select by stable table index; reject unknown/duplicate/empty selections.
MULTI_ONLY="${MULTI_ONLY:-0,1}"
[[ "$MULTI_ONLY" =~ ^[0-2](,[0-2])*$ ]] || { echo "FATAL: invalid MULTI_ONLY=$MULTI_ONLY"; exit 2; }
for idx in "${!TRAINERS[@]}"; do
  case ",$MULTI_ONLY," in *,"$idx",*) ;; *) unset 'TRAINERS[idx]' ;; esac
done
IFS=',' read -ra selected <<< "$MULTI_ONLY"
(( ${#selected[@]} == ${#TRAINERS[@]} )) || { echo "FATAL: duplicate MULTI_ONLY seats"; exit 2; }
CLI_DIALECT="${CLI_DIALECT:-legacy}"
case "$CLI_DIALECT" in legacy|tokens) ;; *) echo "FATAL: invalid CLI_DIALECT=$CLI_DIALECT"; exit 2;; esac
[[ "$SPARES" =~ ^[0-9]+$ ]] || { echo "FATAL: invalid SPARES=$SPARES"; exit 2; }

# Validate PBS allocation
[[ -n "${PBS_NODEFILE:-}" && -f "$PBS_NODEFILE" ]] || { echo "FATAL: PBS_NODEFILE missing"; exit 1; }
TOTAL_AVAIL=$(wc -l < "$PBS_NODEFILE")
NEED=0
for row in "${TRAINERS[@]}"; do
  IFS='|' read -r _m nnodes _port _wd _ckpt _dfl _lr _init _decay _minlr _tok _sp _rs _gbs <<< "$row"
  NEED=$(( NEED + nnodes + _sp ))
done
echo "Nodes: need=$NEED available=$TOTAL_AVAIL spares/chain=$SPARES"
if (( TOTAL_AVAIL < NEED )); then
  echo "FATAL: allocation too small: have $TOTAL_AVAIL need $NEED (select=$NEED for this umbrella)"
  exit 1
fi

# Capture source mtimes BEFORE any fork operation
declare -A SRC_MTIME_BEFORE
SOURCES=()
[[ -n "${TRAINERS[0]:-}" ]] && SOURCES+=("$CKPT_20B512_SRC")
[[ -n "${TRAINERS[1]:-}" ]] && SOURCES+=("$CKPT_20B256_SRC")
for SRC in "${SOURCES[@]}"; do
  if [[ ! -d "$SRC" ]]; then
    echo "FATAL: source ckpt dir missing: $SRC"
    exit 1
  fi
  if ! ls "$SRC"/step-*/.metadata >/dev/null 2>&1; then
    echo "FATAL: source $SRC has no step-*/.metadata — not a valid DCP dir"
    exit 1
  fi
  SRC_MTIME_BEFORE["$SRC"]="$(stat -c %Y "$SRC" 2>/dev/null || stat -f %m "$SRC" 2>/dev/null || echo 0)"
done
echo "Source ckpt dirs OK (metadata present)"

# Fresh output forks must not silently start from random weights. Select an
# explicit DCP step, not its parent directory; never infer "latest" here.
declare -A SEEN_WORKDIR
for idx in "${!TRAINERS[@]}"; do
  row="${TRAINERS[$idx]}"
  IFS='|' read -r _m _n _port _wd _ckpt _dfl _lr initial _decay _minlr _tok _sp rs gbs <<< "$row"
  [[ -d "$_wd" ]] || { echo "FATAL: trainer $idx workdir missing: $_wd"; exit 2; }
  canonical_wd=$(cd "$_wd" && pwd -P) || exit 2
  if [[ -n "${SEEN_WORKDIR[$canonical_wd]:-}" ]]; then
    echo "FATAL: trainer $idx shared workdir $canonical_wd (auto-retry state collision)"; exit 2
  fi
  SEEN_WORKDIR[$canonical_wd]=1
  case "$idx" in
    0) pin="${EXPECTED_HEAD_20B512:-}" ;;
    1) pin="${EXPECTED_HEAD_20B256:-}" ;;
    2) pin="${EXPECTED_HEAD_2B:-}" ;;
  esac
  seat_head=$(git -C "$_wd" rev-parse HEAD) || exit 2
  git -C "$_wd" diff --quiet && git -C "$_wd" diff --cached --quiet || {
    echo "FATAL: trainer $idx tracked source edits"; exit 16;
  }
  if [[ -n "$pin" && "$pin" != "$seat_head" ]]; then
    echo "FATAL: trainer $idx HEAD $seat_head does not match pinned $pin"; exit 16
  fi
  if ! grep -q "BLENDCORPUS_RESUME_CONSUMED_SAMPLES" \
      "$_wd/torchtitan/experiments/ezpz/blendcorpus/blendcorpus_builder.py"; then
    echo "FATAL: trainer $idx position fix missing in $_wd"; exit 2
  fi
  if [[ "$initial" != /* || ! -f "$initial/.metadata" ]]; then
    echo "FATAL: $_m initial load must explicitly name a valid DCP step (.metadata): $initial"
    exit 2
  fi
  if (( rs % gbs != 0 )); then
    echo "FATAL: resume_samples $rs not aligned to GBS $gbs"
    exit 2
  fi
done

# Slice dir
JOBID="${PBS_JOBID%%.*}"; [[ -z "$JOBID" ]] && JOBID="nojob"
MULTI_LOG_DIR="${PBS_O_WORKDIR:-$PWD}/logs/multi-autoretry-${JOBID}"
mkdir -p "$MULTI_LOG_DIR" || exit 1
case "$MULTI_LOG_DIR" in /*) : ;; *) MULTI_LOG_DIR="$(cd "$MULTI_LOG_DIR" && pwd)" ;; esac
echo "Logs under: $MULTI_LOG_DIR"

# Slice nodefile into disjoint hostfiles
offset=1
declare -a T_SLICE
for idx in "${!TRAINERS[@]}"; do
  IFS='|' read -r _m nnodes _port _wd _ckpt _dfl _lr _init _decay _minlr _tok _sp _rs _gbs <<< "${TRAINERS[$idx]}"
  slice_count=$(( nnodes + _sp ))
  slice_file="$MULTI_LOG_DIR/trainer-${idx}.hostfile"
  sed -n "${offset},$((offset + slice_count - 1))p" "$PBS_NODEFILE" > "$slice_file"
  got=$(wc -l < "$slice_file")
  if (( got != slice_count )); then
    echo "FATAL: trainer $idx sliced $got nodes expected $slice_count offset=$offset"
    exit 1
  fi
  T_SLICE[$idx]="$slice_file"
  offset=$(( offset + slice_count ))
done
# Non-overlap check
dupes=$(cat "${T_SLICE[@]}" | sort | uniq -d)
if [[ -n "$dupes" ]]; then
  echo "FATAL: slices overlap:"; echo "$dupes"; exit 1
fi
echo "Slices disjoint OK"

# Resolved banner
echo "============================================================"
echo "  agpt boost umbrella (native auto-retry)  jobid=$JOBID"
for idx in "${!TRAINERS[@]}"; do
  IFS='|' read -r model nnodes port wd ckpt dfl lr init decay minlr tok sp rs gbs <<< "${TRAINERS[$idx]}"
  echo "  trainer $idx: $model n=$nnodes gbs=$gbs port=$port ckpt=$ckpt resume_samples=$rs workdir=$wd dialect=$CLI_DIALECT"
done
echo "============================================================"

if [[ "${DRY_RUN:-0}" == "1" ]]; then
  echo "Dry run OK: no checkpoint directories created, runtime staged, or trainers launched"
  exit 0
fi

for row in "${TRAINERS[@]}"; do
  IFS='|' read -r _m _n _port _wd D _rest <<< "$row"
  if [[ ! -d "$D" ]]; then
    echo "Creating fork dir: $D"
    mkdir -p "$D" || exit 1
    lfs setstripe -c 2 -i 10 "$D" 2>&1 || echo "WARNING: lfs setstripe failed for $D"
  fi
done

# Verify source mtime unchanged after fork (fork must not mutate source)
for SRC in "${SOURCES[@]}"; do
  AFTER="$(stat -c %Y "$SRC" 2>/dev/null || stat -f %m "$SRC" 2>/dev/null || echo 0)"
  BEFORE="${SRC_MTIME_BEFORE[$SRC]}"
  if [[ "$AFTER" != "$BEFORE" ]]; then
    echo "FATAL: source $SRC mtime changed after fork: before=$BEFORE after=$AFTER"
    echo "  (fork must not mutate source — check for accidental mv/cp into source)"
    exit 3
  fi
done
echo "Checkpoint dirs OK (fork clean, source mtime unchanged)"

# ── Venv broadcast (immutable production archive, no activation fallback) ──
VENV_ARCHIVE="${VENV_ARCHIVE:-/flare/AuroraGPT/foremans/scratch/diagnostics/runtime-artifacts/.venv-20b-prod-ezpz0292-f7deda7-20260929.tar.gz}"
VENV_ARCHIVE_SHA="${VENV_ARCHIVE_SHA:-e273ae228db8107adfb2f21ce67e3e3ec2f6f7973c373f3dc440c96543e7bccc}"
LAUNCHER_VENV="${LAUNCHER_VENV:-/flare/AuroraGPT/foremans/venvs/xpu-torch215}"
EZPZ_UTILS="${EZPZ_UTILS:-/flare/AuroraGPT/foremans/scratch/diagnostics/runtime-artifacts/ezpz-utils-f7deda7.sh}"
VENV_DST="${VENV_DST:-/tmp/.venv-20b-restart-20261029}"
[[ -f "$VENV_ARCHIVE" ]] || { echo "FATAL: missing runtime archive: $VENV_ARCHIVE"; exit 1; }
[[ "$VENV_ARCHIVE_SHA" =~ ^[[:xdigit:]]{64}$ ]] || { echo "FATAL: invalid VENV_ARCHIVE_SHA"; exit 1; }
if command -v sha256sum >/dev/null 2>&1; then
  archive_sum=$(sha256sum "$VENV_ARCHIVE") || exit 1
else
  archive_sum=$(shasum -a 256 "$VENV_ARCHIVE") || exit 1
fi
[[ "${archive_sum%% *}" == "$VENV_ARCHIVE_SHA" ]] || { echo "FATAL: archive SHA mismatch: $archive_sum"; exit 16; }
[[ -x "$LAUNCHER_VENV/bin/ezpz" && -f "$EZPZ_UTILS" ]] || { echo "FATAL: launcher/utils missing"; exit 1; }
source "$EZPZ_UTILS" || { echo "FATAL: sourcing ezpz utils failed"; exit 1; }
declare -F ezpz_load_modules >/dev/null || { echo "FATAL: ezpz_load_modules missing"; exit 1; }
declare -F ezpz_setup_job >/dev/null || { echo "FATAL: ezpz_setup_job missing"; exit 1; }
ezpz_load_modules || { echo "FATAL: ezpz_load_modules failed"; exit 1; }
ezpz_setup_job || { echo "FATAL: ezpz_setup_job failed"; exit 1; }
"$LAUNCHER_VENV/bin/ezpz" yeet --src "$VENV_ARCHIVE" --hostfile "$PBS_NODEFILE" --dst "$VENV_DST" \
  > "$MULTI_LOG_DIR/prestage.console.log" 2>&1 || { echo "FATAL: runtime staging failed; see $MULTI_LOG_DIR/prestage.console.log"; exit 1; }
[[ -x "$VENV_DST/bin/ezpz" && -x "$VENV_DST/bin/python" ]] || { echo "FATAL: staged entry points missing: $VENV_DST"; exit 1; }
unset PYTHONPATH
export ZE_FLAT_DEVICE_HIERARCHY=FLAT CCL_OP_SYNC=1 CCL_ATL_SYNC_COLL=1
export CCL_KVS_MODE=pmi CCL_SYCL_KERNEL_SYNC=0
"$VENV_DST/bin/python" -c "import torch; assert torch.xpu.is_available(); print(f'torch {torch.__version__} xpu={torch.xpu.is_available()}')" \
  || { echo "FATAL: staged torch/XPU probe failed"; exit 1; }
echo "Venv OK: $VENV_DST archive_sha=$VENV_ARCHIVE_SHA"

# Check source/runtime visibility on every allocated active AND spare host.
# A login-node check or a four-node canary does not establish 788-node mounts.
RESTART_PROBE_DIRS="$REPO"
RESTART_PROBE_WRITES=""
RESTART_PROBE_SEEDS=""
for row in "${TRAINERS[@]}"; do
  IFS='|' read -r _m _n _port _wd _ckpt _dfl _lr _seed _rest <<< "$row"
  RESTART_PROBE_DIRS+="|$_wd"
  RESTART_PROBE_WRITES+="|$_ckpt"
  RESTART_PROBE_SEEDS+="|$_seed"
done
export RESTART_PROBE_DIRS RESTART_PROBE_WRITES RESTART_PROBE_SEEDS
export RESTART_PROBE_VENV="$VENV_DST"
"$VENV_DST/bin/ezpz" launch --nproc "$TOTAL_AVAIL" --nproc_per_node 1 \
  --hostfile "$PBS_NODEFILE" -- "$VENV_DST/bin/python" -c '
import os, socket
from pathlib import Path
import torch
for value in os.environ["RESTART_PROBE_DIRS"].split("|"):
    if value:
        assert (Path(value)/"torchtitan/experiments/ezpz/blendcorpus/blendcorpus_builder.py").is_file(), value
for value in os.environ["RESTART_PROBE_WRITES"].split("|"):
    if value:
        assert Path(value).is_dir() and os.access(value, os.W_OK), value
for value in os.environ["RESTART_PROBE_SEEDS"].split("|"):
    if value:
        assert (Path(value)/".metadata").stat().st_size > 0, value
for name in ["python", "ezpz"]:
    path = Path(os.environ["RESTART_PROBE_VENV"])/"bin"/name
    assert path.is_file() and os.access(path, os.X_OK), str(path)
assert torch.xpu.is_available() and torch.xpu.device_count() >= 12
print("RESTART_HOST_PREFLIGHT_PASS", socket.gethostname(), flush=True)
' > "$MULTI_LOG_DIR/allocated-host-preflight.log" 2>&1 || {
  echo "FATAL: allocated-host source/runtime preflight failed; see $MULTI_LOG_DIR/allocated-host-preflight.log"
  exit 1
}

# ---- Launch function ----
launch_trainer() {
  local idx="$1" attempt="${2:-1}"
  IFS='|' read -r model nnodes port workdir ckpt dfl_name lr_val init_load decay_ratio min_lr_factor train_tokens spares resume_samples gbs <<< "${TRAINERS[$idx]}"
  local slice="${T_SLICE[$idx]}"
  local nproc=$(( nnodes * PPN ))
  local training_steps
  training_steps=$(( train_tokens / (gbs * SEQ_LEN) ))
  local tokens_per_microbatch_per_dp_rank=$(( LBS * SEQ_LEN ))
  local tokens_per_train_step=$(( gbs * SEQ_LEN ))
  local console="$MULTI_LOG_DIR/trainer-${idx}-${model}-n${nnodes}-attempt-${attempt}.console.log"
  local dfl="torchtitan/experiments/ezpz/data-lists/aurora/${dfl_name}.txt"
  local data_cache="${ckpt}/.cache/${dfl_name}/index-cache"
  case "$idx" in
    0) data_cache="${DATA_CACHE_20B512:-$data_cache}" ;;
    1) data_cache="${DATA_CACHE_20B256:-$data_cache}" ;;
  esac
  local hf_assets="${HF_ASSETS:-/flare/AuroraGPT/foremans/projects/saforem2/torchtitan-ezpz/assets/hf/gemma-7b}"

  # Config name: agpt_${MODEL}${CONFIG_SUFFIX} — real names from submit_agpt_*_autoretry.sh
  # CONFIG_SUFFIX=_real for cos_sin RoPE (production default)
  local config_suffix="_real"
  local config_name="agpt_${model}${config_suffix}"

  # Resume guard: if this trainer has a resume position, validate GBS alignment
  if [[ "$resume_samples" != "0" && -n "$resume_samples" ]]; then
    if (( resume_samples % gbs != 0 )); then
      echo "FATAL: trainer $idx resume_samples $resume_samples not aligned to GBS $gbs" >&2
      exit 2
    fi
  fi

  local batch_args=()
  if [[ "$CLI_DIALECT" == "legacy" ]]; then
    batch_args=(--training.local-batch-size="$LBS" --training.global-batch-size="$gbs" --training.seq-len="$SEQ_LEN")
  else
    batch_args=(--training.num-tokens-per-microbatch-per-dp-rank="$tokens_per_microbatch_per_dp_rank"
      --training.num-tokens-per-train-step="$tokens_per_train_step" --training.max-context-length="$SEQ_LEN")
  fi

  local xtra=()
  [[ -n "$init_load" ]] && xtra+=(--checkpoint.initial-load-path="$init_load" --checkpoint.no-initial-load-model-only)
  xtra+=(--lr-scheduler.decay-ratio="$decay_ratio" --lr-scheduler.min-lr-factor="$min_lr_factor" --lr-scheduler.warmup-steps=20)

  # Per-trainer resume: BLENDCORPUS_RESUME_CONSUMED_SAMPLES env var propagated
  # via mpiexec --envall is the PRODUCTION path — the pinned launcher cannot
  # pass new CLI flags, so --dataloader.resume-consumed-samples would be
  # rejected as "Unrecognized options" on that build. Env var only.

  (
    cd "$workdir" || { echo "cd failed: $workdir"; exit 97; }
    # Export per-trainer resume position — mpiexec --envall carries it to all ranks
    if [[ "$resume_samples" != "0" && -n "$resume_samples" ]]; then
      export BLENDCORPUS_RESUME_CONSUMED_SAMPLES="$resume_samples"
    else
      unset BLENDCORPUS_RESUME_CONSUMED_SAMPLES || true
    fi
    export MASTER_PORT="$port"; unset MASTER_ADDR
    # Use exactly the staged immutable runtime, never an activation fallback.
    VENV_BIN="$VENV_DST"
    export VIRTUAL_ENV="$VENV_BIN"
    export PATH="$VENV_BIN/bin:$PATH"
    hash -r
    "$VENV_BIN/bin/ezpz" launch \
      --nproc "$nproc" \
      --nproc_per_node "$PPN" \
      --hostfile "$slice" \
      --auto-retry \
      --spare-nodes "$spares" \
      --timeout "$IDLE_TIMEOUT" \
      -- \
      "$VENV_BIN/bin/python" -m torchtitan.experiments.ezpz.train \
      --module=ezpz.agpt \
      --config="$config_name" \
      --hf-assets-path="$hf_assets" \
      --checkpoint.enable \
      --checkpoint.folder="$ckpt" \
      --checkpoint.interval="$CKPT_INTERVAL" \
      --checkpoint.keep-latest-k=0 \
      --checkpoint.no-last-save-model-only \
      --checkpoint.async-mode=disabled \
      --dataloader.dataset=blendcorpus \
      --dataloader.dataset-path="$dfl" \
      --dataloader.data-cache-path="$data_cache" \
      --validator.enable --validator.freq=100 --validator.steps=10 \
      --validator.dataloader.dataset-path="$dfl" --validator.dataloader.data-cache-path="$data_cache" \
      "${xtra[@]}" \
      --optimizer "$OPTIMIZER" \
      --optimizer.lr="$lr_val" \
      "${batch_args[@]}" \
      --training.steps="$training_steps"
  ) > "$console" 2>&1 &
  TRAINER_PID=$!
}

# ---- Supervise (with relaunch) ----
JOB_START_EPOCH=$(date +%s)
WALLTIME_SECS=43200
if [[ -n "${PBS_JOBID:-}" ]] && command -v qstat >/dev/null 2>&1; then
  _wt=$(qstat -f "$PBS_JOBID" 2>/dev/null | tr -d '\n' | grep -oE 'Resource_List.walltime = [0-9:]+' | head -1 | awk '{print $3}')
  if [[ "$_wt" =~ ^([0-9]+):([0-9]+):([0-9]+)$ ]]; then
    WALLTIME_SECS=$(( ${BASH_REMATCH[1]}*3600 + ${BASH_REMATCH[2]}*60 + ${BASH_REMATCH[3]} ))
  fi
fi
JOB_DEADLINE=$(( JOB_START_EPOCH + WALLTIME_SECS ))
secs_left() { echo $(( JOB_DEADLINE - $(date +%s) )); }

declare -a PIDS RC SUP_PIDS
LAUNCHER_RAN_FILE="$MULTI_LOG_DIR/.launcher_ran"

supervise_trainer() {
  local idx="$1" attempt=1 rc=0 t0 dt left quick=0
  SEAT_RELAUNCH="${SEAT_RELAUNCH:-1}"
  SEAT_RELAUNCH_MIN_LEFT="${SEAT_RELAUNCH_MIN_LEFT:-2700}"
  SEAT_MIN_HEALTHY_SECS="${SEAT_MIN_HEALTHY_SECS:-600}"
  SEAT_MAX_QUICK_DEATHS="${SEAT_MAX_QUICK_DEATHS:-2}"
  while :; do
    t0=$(date +%s)
    launch_trainer "$idx" "$attempt"
    pid=$TRAINER_PID
    PIDS[$idx]=$pid
    touch "$LAUNCHER_RAN_FILE"
    wait "$pid"; rc=$?
    dt=$(( $(date +%s) - t0 ))
    echo "[boost $(date +%H:%M:%S)] trainer $idx attempt $attempt finished rc=$rc after ${dt}s"
    RC[$idx]=$rc
    (( rc == 0 )) && { echo "[boost] trainer $idx complete rc=0 — not relaunching"; return 0; }
    [[ "$SEAT_RELAUNCH" != "1" ]] && return "$rc"
    if (( dt < SEAT_MIN_HEALTHY_SECS )); then
      quick=$(( quick + 1 ))
      if (( quick >= SEAT_MAX_QUICK_DEATHS )); then
        echo "[boost] trainer $idx $quick quick deaths — seat broken, giving up"
        return "$rc"
      fi
    else
      quick=0
    fi
    left=$(secs_left)
    if (( left < SEAT_RELAUNCH_MIN_LEFT )); then
      echo "[boost] trainer $idx ${left}s left (< ${SEAT_RELAUNCH_MIN_LEFT}s) — not relaunching"
      return "$rc"
    fi
    attempt=$(( attempt + 1 ))
    echo "[boost] trainer $idx relaunching attempt $attempt ${left}s left"
    sleep 10
  done
}

for idx in "${!TRAINERS[@]}"; do
  supervise_trainer "$idx" &
  SUP_PIDS[$idx]=$!
  sleep "${LAUNCH_STAGGER:-20}"
done
echo "[boost] all ${#TRAINERS[@]} trainers under supervision; waiting..."

fails=0
for idx in "${!TRAINERS[@]}"; do
  wait "${SUP_PIDS[$idx]}"; RC[$idx]=$?
  (( RC[$idx] == 0 )) || fails=$(( fails + 1 ))
  echo "[boost] trainer $idx supervisor exited rc=${RC[$idx]}"
done

# Hard fail if launcher never ran (no silent echo+exit 0)
if [[ ! -f "$LAUNCHER_RAN_FILE" ]]; then
  echo "FATAL: launcher never executed — no trainer was started (PBS_NODEFILE or slicing failure?)"
  exit 99
fi

echo "============================================================"
echo "  boost umbrella summary (jobid=$JOBID)"
echo "============================================================"
for idx in "${!TRAINERS[@]}"; do
  status="OK"; (( RC[idx] == 0 )) || status="FAIL(${RC[idx]})"
  IFS='|' read -r model nnodes _port _wd ckpt _dfl _lr _init _decay _minlr _tok _sp _rs _gbs <<< "${TRAINERS[$idx]}"
  printf '  trainer %d: %-4s n=%-4s %-10s ckpt=%s resume=%s\n' "$idx" "$model" "$nnodes" "$status" "$ckpt" "$_rs"
  printf '             log: %s\n' "$MULTI_LOG_DIR/trainer-${idx}-${model}-n${nnodes}-attempt-*.console.log"
done
echo "  failed: $fails / ${#TRAINERS[@]}"
echo "============================================================"
exit "$fails"
