#!/bin/bash --login
#PBS -A datascience
#PBS -N agpt2b-sft100-xccl-sync
#PBS -l walltime=00:45:00
#PBS -l filesystems=tegu:home
#PBS -l select=1
#PBS -q workq
#PBS -j oe
set -o pipefail

WT=/lus/tegu/projects/datascience/foremans/projects/saforem2/torchtitan-sync-416e12cb8
V=/lus/tegu/projects/datascience/foremans/venvs/rl-monarch-torch214
CKPT=/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-mds154391-alphabet-sft100/final
OUT=/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-sft100-torchstore-sync-${PBS_JOBID%%.*}
EXPECTED_SHA=cd8c185a84c0ef274d04b0be91ba72046b02e7533d9f0507f4948b146e0a5c6e

cd "$WT" || exit 11
source <(curl -fsSL https://bit.ly/ezpz-utils) || exit 12
ezpz_setup "$V" || exit 13
[[ "$ZE_FLAT_DEVICE_HIERARCHY" == FLAT ]] || exit 14

export PATH="$V/bin:/opt/pbs/bin:$PATH"
export PYTHONPATH="$WT${PYTHONPATH:+:$PYTHONPATH}"
export TORCHTITAN_TORCHSTORE_TRANSPORT=xccl
export TORCHINDUCTOR_MAX_AUTOTUNE=0 VLLM_ENABLE_V1_MULTIPROCESSING=1
export WANDB_MODE=disabled HF_DATASETS_OFFLINE=1 HF_HUB_OFFLINE=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1

# Monarch spawns the trainer and generator actors itself. Replace ezpz's
# ordinary MPI/PMIx CCL bootstrap with the same-node TCP-KVS contract used by
# the validated XPU RL path; do not launch the controller under mpiexec.
unset CCL_OP_SYNC CCL_OFI_PROVIDER
unset FI_CXI_DEFAULT_CQ_SIZE FI_CXI_DEFAULT_TX_SIZE FI_CXI_OFLOW_BUF_COUNT
unset FI_CXI_OFLOW_BUF_SIZE FI_CXI_RDZV_EAGER_SIZE FI_CXI_RDZV_THRESHOLD
unset FI_CXI_REQ_BUF_MAX_CACHED FI_CXI_REQ_BUF_MIN_POSTED FI_CXI_REQ_BUF_SIZE
unset FI_CXI_RX_MATCH_MODE FI_MR_CACHE_MAX_COUNT FI_MR_CACHE_MAX_SIZE
export CCL_PROCESS_LAUNCHER=none
export CCL_ATL_TRANSPORT=ofi
export FI_PROVIDER=tcp
export CCL_KVS_IP_PORT="127.0.0.1_$((29500 + ${PBS_JOBID%%.*} % 1000))"

mkdir -p "$OUT"
sha=$(sha256sum "$CKPT/model.safetensors" | cut -d' ' -f1)
[[ "$sha" == "$EXPECTED_SHA" ]] || { echo "bad model sha $sha"; exit 15; }
PYTHONPATH="$WT" "$V/bin/python" -c \
  'from torchtitan.experiments.ezpz.rl.alphabet_sort_agpt.config_registry import rl_sync_agpt_2b_clean as f; c=f(); assert c.async_loop.num_training_steps == 1; assert c.async_loop.validation.num_samples == 8' \
  || exit 16

echo "AGPT_SFT100_XCCL_SYNC_START $(date -Is) commit=$(git rev-parse HEAD) model_sha=$sha out=$OUT"
"$V/bin/python" -u -m torchtitan.experiments.ezpz.rl.train_upstream \
  --module torchtitan.experiments.ezpz.rl.alphabet_sort_agpt \
  --config rl_sync_agpt_2b_clean \
  --hf_assets_path="$CKPT" \
  --dump_folder="$OUT" \
  --async-loop.num-training-steps=1 \
  --async-loop.num-prompts-per-train-step=2 \
  --async-loop.num-samples-per-prompt=4 \
  --async-loop.target-offpolicy-steps=0 \
  --async-loop.validation.num-samples=8 \
  --async-loop.training-sample-builder.no-drop-zero-std-reward-groups \
  --generator.sampling.max-tokens=128 \
  --generator.parallelism.data-parallel-degree=1 \
  --generator.parallelism.tensor-parallel-degree=1 \
  --trainer.parallelism.data-parallel-shard-degree=1 \
  --trainer.parallelism.tensor-parallel-degree=1 \
  --trainer.checkpointer.interval=1 \
  --metrics.no-enable-wandb
rc=$?
echo "AGPT_SFT100_XCCL_SYNC_DONE rc=$rc $(date -Is)"
exit "$rc"
