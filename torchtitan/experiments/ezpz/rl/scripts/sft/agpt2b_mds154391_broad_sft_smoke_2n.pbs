#!/bin/bash --login
#PBS -A datascience
#PBS -N mds154391-grain-sft-smoke
#PBS -l walltime=01:00:00
#PBS -l filesystems=tegu:home
#PBS -l select=2
#PBS -q workq
#PBS -j oe
set -o pipefail

WT=/lus/tegu/projects/datascience/foremans/projects/saforem2/torchtitan-sync-416e12cb8
V=/lus/tegu/projects/datascience/foremans/venvs/rl-monarch-torch214
BASE=/lus/tegu/projects/datascience/foremans/artifacts/agpt-2b-mds-stage3-mix-step154391-hf
OUT=/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-mds154391-broad-grain-smoke
: "${EXPECTED_COMMIT:?submit with -v EXPECTED_COMMIT=<exact-pushed-sha>}"
EXPECTED_MODEL_SHA=df4a7289d4eddb57c380d14ceb4c510d7ee6c55b5b79a7ef0f96a3a61e644fd1

cd "$WT" || exit 11
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]] || exit 12
source <(curl -fsSL https://bit.ly/ezpz-utils) || exit 13
ezpz_setup "$V" || exit 14
[[ "$ZE_FLAT_DEVICE_HIERARCHY" == FLAT ]] || exit 15
export PATH="$V/bin:/opt/pbs/bin:$PATH"
export PYTHONPATH="$WT${PYTHONPATH:+:$PYTHONPATH}"
export CCL_PROCESS_LAUNCHER=pmix
export CCL_OP_SYNC=1
export CCL_ATL_SYNC_COLL=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 WANDB_MODE=disabled
export PYTHONIOENCODING="ascii:replace"
export MDS154391_SFT_BASE="$BASE"

sha=$(sha256sum "$BASE/model-00001-of-00001.safetensors" | cut -d' ' -f1)
[[ "$sha" == "$EXPECTED_MODEL_SHA" ]] || exit 16
[[ ! -e "$OUT" ]] || "$HOME/.local/bin/backup" "$OUT"

printf 'MDS154391_GRAIN_SFT_SMOKE_START %s commit=%s model_sha=%s\n' \
  "$(date -Is)" "$(git rev-parse HEAD)" "$sha"
printf 'MDS154391_GRAIN_SFT_COMM CCL_PROCESS_LAUNCHER=%s CCL_OP_SYNC=%s CCL_ATL_SYNC_COLL=%s ZE_FLAT_DEVICE_HIERARCHY=%s\n' \
  "$CCL_PROCESS_LAUNCHER" "$CCL_OP_SYNC" "$CCL_ATL_SYNC_COLL" "$ZE_FLAT_DEVICE_HIERARCHY"
[[ "$CCL_PROCESS_LAUNCHER" == pmix && "$CCL_OP_SYNC" == 1 && \
   "$CCL_ATL_SYNC_COLL" == 1 ]] || exit 17
"$V/bin/ezpz" launch --nproc 24 --nproc_per_node 12 --timeout 1800 -- \
  "$V/bin/python" -u -m torchtitan.experiments.ezpz.train \
  --module=ezpz.agpt \
  --config=agpt_2b_mds154391_tulu_math_uc_streaming \
  --dump-folder="$OUT" \
  --training.steps=20 \
  --training.num-tokens-per-train-step=49152 \
  --parallelism.tensor-parallel-degree=1 \
  --parallelism.data-parallel-shard-degree=12 \
  --parallelism.data-parallel-replicate-degree=2 \
  --metrics.log-freq=1 \
  --metrics.no-enable-wandb \
  --checkpointer.folder="$OUT/checkpoints" \
  --checkpointer.interval=20 \
  --checkpointer.async-mode=disabled \
  --debug.seed=42
rc=$?
echo "MDS154391_GRAIN_SFT_SMOKE_DONE rc=$rc $(date -Is)"
exit "$rc"
