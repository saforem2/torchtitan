#!/bin/bash --login
#PBS -A datascience
#PBS -N mds154391-broad-sft-smoke
#PBS -l walltime=01:00:00
#PBS -l filesystems=tegu:home
#PBS -l select=2
#PBS -q workq
#PBS -j oe
set -o pipefail

WT=/lus/tegu/projects/datascience/foremans/projects/saforem2/torchtitan-sync-416e12cb8
V=/lus/tegu/projects/datascience/foremans/venvs/rl-monarch-torch214
BASE=/lus/tegu/projects/datascience/foremans/artifacts/agpt-2b-mds-stage3-mix-step154391-hf
PRETOK=/tegu/datasets/datasets/agpt2b-mds154391-tulu-math-uc-mix-len1024
OUT=/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-mds154391-broad-sft-smoke
EXPECTED_MODEL_SHA=df4a7289d4eddb57c380d14ceb4c510d7ee6c55b5b79a7ef0f96a3a61e644fd1
EXPECTED_ROWS=53276203

cd "$WT" || exit 11
source <(curl -fsSL https://bit.ly/ezpz-utils) || exit 12
ezpz_setup "$V" || exit 13
[[ "$ZE_FLAT_DEVICE_HIERARCHY" == FLAT ]] || exit 14
export PATH="$V/bin:/opt/pbs/bin:$PATH"
export PYTHONPATH="$WT${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 WANDB_MODE=disabled
export PYTHONIOENCODING="ascii:replace"

sha=$(sha256sum "$BASE/model-00001-of-00001.safetensors" | cut -d' ' -f1)
[[ "$sha" == "$EXPECTED_MODEL_SHA" ]] || exit 15
"$V/bin/python" - "$PRETOK" "$EXPECTED_ROWS" <<'PY' || exit 16
import sys
from datasets import load_from_disk
d = load_from_disk(sys.argv[1])
assert len(d) == int(sys.argv[2]), (len(d), sys.argv[2])
assert {"input_ids", "assistant_masks", "seq_lengths"} <= set(d.column_names)
print(f"BROAD_SFT_DATASET_OK rows={len(d)} columns={d.column_names}")
PY
[[ ! -e "$OUT" ]] || "$HOME/.local/bin/backup" "$OUT"

printf 'MDS154391_BROAD_SFT_SMOKE_START %s commit=%s model_sha=%s\n' \
  "$(date -Is)" "$(git rev-parse HEAD)" "$sha"
"$V/bin/ezpz" launch --nproc 24 --nproc_per_node 12 --timeout 1800 -- \
  "$V/bin/python" -u -m torchtitan.experiments.ezpz.rl.train_sft \
  --pretokenized_dataset "$PRETOK" --model_name_or_path "$BASE" \
  --output_dir "$OUT" --max_steps 20 --num_train_epochs 1 \
  --learning_rate 2e-5 --lr_scheduler_type cosine \
  --per_device_train_batch_size 2 --gradient_accumulation_steps 32 \
  --dataset_num_proc 1 --max_train_samples 200000 --max_length 1024 \
  --bf16 --fsdp full_shard --logging_steps 1 --save_strategy no --report_to none
rc=$?
echo "MDS154391_BROAD_SFT_SMOKE_DONE rc=$rc $(date -Is)"
exit "$rc"
