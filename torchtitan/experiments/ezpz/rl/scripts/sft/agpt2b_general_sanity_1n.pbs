#!/bin/bash --login
#PBS -A datascience
#PBS -N agpt2b-general
#PBS -l walltime=00:20:00
#PBS -l select=1
#PBS -l filesystems=tegu:home
#PBS -q workq
#PBS -j oe
set -o pipefail

WT="${PBS_O_WORKDIR:-$(pwd)}"
V="${V:-/lus/tegu/projects/datascience/foremans/venvs/rl-monarch-torch214}"
: "${MODEL:?submit with -v MODEL=<model-dir>}"
: "${OUT:?submit with -v OUT=<jsonl>}"
: "${EXPECTED_COMMIT:?submit with -v EXPECTED_COMMIT=<sha>}"
source <(curl -fsSL https://ezpz.cool/utils.sh) || exit 12
ezpz_setup_job || exit 13
ezpz_load_modules || exit 13
export VIRTUAL_ENV="$V" PATH="$V/bin:$PATH"
hash -r
[[ "$(command -v python)" == "$V/bin/python" ]] || exit 13
cd "$WT" || exit 11
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]] || exit 14
git diff --quiet && git diff --cached --quiet || exit 14
export ZE_FLAT_DEVICE_HIERARCHY=FLAT ZE_AFFINITY_MASK=0
export ONEAPI_DEVICE_SELECTOR="opencl:gpu;level_zero:gpu"
export VLLM_ENABLE_V1_MULTIPROCESSING=1 HF_DATASETS_OFFLINE=1 HF_HUB_OFFLINE=1
"$V/bin/python" -u torchtitan/experiments/ezpz/scripts/eval/agpt_general_sanity.py "$MODEL" "$OUT"
