#!/bin/bash --login
#PBS -A datascience
#PBS -N agpt2b-openmath-distill
#PBS -l walltime=02:00:00
#PBS -l filesystems=tegu:home
#PBS -l select=2
#PBS -q workq
#PBS -j oe
set -o pipefail

WT="${PBS_O_WORKDIR:-$(pwd)}"
V="${V:-/lus/tegu/projects/datascience/foremans/venvs/rl-monarch-torch214}"
BASE="${BASE:-/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-mds154391-broad-grain-sft900/stage4/accepted/agpt2b-stage4-metamath-alpha65}"
PRETOK="${PRETOK:-/tegu/datasets/datasets/agpt2b-openmath-verified-replay-len2048-v1}"
ROOT="${ROOT:-/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-mds154391-broad-grain-sft900/stage6/openmath-verified-${PBS_JOBID%%.*}}"
: "${EXPECTED_COMMIT:?submit with -v EXPECTED_COMMIT=<exact-pushed-sha>}"

source <(curl -fsSL https://bit.ly/ezpz-utils) || exit 12
ezpz_setup "$V" || exit 13
cd "$WT" || exit 11
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]] || exit 14
git diff --quiet && git diff --cached --quiet || exit 14
[[ -s "$BASE/model.safetensors" && -s "$PRETOK/state.json" ]] || exit 15
[[ ! -e "$ROOT" ]] || exit 16
mkdir -p "$ROOT"

export PATH="$V/bin:/opt/pbs/bin:$PATH"
export PYTHONPATH="$WT${PYTHONPATH:+:$PYTHONPATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ONEAPI_DEVICE_SELECTOR="opencl:gpu;level_zero:gpu"
export CCL_PROCESS_LAUNCHER=pmix CCL_OP_SYNC=1 CCL_ATL_SYNC_COLL=1
export CCL_ZE_CACHE_GET_IPC_HANDLES_THRESHOLD=8000 CCL_ZE_CACHE_OPEN_IPC_HANDLES_THRESHOLD=8000
export TORCH_CPP_LOG_LEVEL=ERROR
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1 WANDB_MODE=disabled
export TMPDIR=/lus/tegu/projects/datascience/foremans/tmp/agpt2b-openmath-distill-${PBS_JOBID%%.*}
mkdir -p "$TMPDIR"

printf 'AGPT2B_OPENMATH_DISTILL_START commit=%s root=%s\n' "$(git rev-parse HEAD)" "$ROOT"
"$V/bin/ezpz" launch --auto-retry --nproc 24 --nproc_per_node 12 --timeout 1800 -- \
  "$V/bin/python" -u -m torchtitan.experiments.ezpz.rl.train_sft \
  --pretokenized_dataset "$PRETOK" --model_name_or_path "$BASE" \
  --output_dir "$ROOT" --max_steps 100 --num_train_epochs 1 \
  --learning_rate 3e-6 --lr_scheduler_type linear --warmup_steps 5 \
  --per_device_train_batch_size 1 --gradient_accumulation_steps 1 \
  --dataset_num_proc 1 --max_length 2048 --assistant_only_loss false \
  --bf16 --fsdp full_shard --logging_steps 1 \
  --save_strategy steps --save_steps 25 --save_total_limit 4 --report_to none
rc=$?
echo "AGPT2B_OPENMATH_DISTILL_DONE rc=$rc $(date -Is)"
exit "$rc"
