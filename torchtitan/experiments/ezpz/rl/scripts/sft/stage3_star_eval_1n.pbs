#!/bin/bash --login
#PBS -A datascience
#PBS -l walltime=00:30:00
#PBS -l select=1
#PBS -l filesystems=tegu:home
#PBS -q workq
#PBS -j oe
set -o pipefail

module load oneapi/release/2025.3.1 hdf5 pti-gpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT ZE_AFFINITY_MASK=0
export CCL_PROCESS_LAUNCHER=pmix CCL_OP_SYNC=1 CCL_ATL_SYNC_COLL=1
export ONEAPI_DEVICE_SELECTOR="opencl:gpu;level_zero:gpu"
export TORCH_CPP_LOG_LEVEL=ERROR TORCHINDUCTOR_MAX_AUTOTUNE=0
export VLLM_ENABLE_V1_MULTIPROCESSING=1 HF_DATASETS_OFFLINE=1 HF_HUB_OFFLINE=1

SUBMIT_DIR="${PBS_O_WORKDIR:-$(pwd)}"
VENV="${VENV:-/lus/tegu/projects/datascience/foremans/venvs/rl-monarch-torch214}"
MODEL="${MODEL:-/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-mds154391-broad-grain-sft900/stage3/sft-12478715/final}"
RESULT="${RESULT:-/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-mds154391-broad-grain-sft900/stage3/eval-12478715-gsm8k-200}"
: "${EXPECTED_COMMIT:?submit with -v EXPECTED_COMMIT=<exact-pushed-sha>}"

source <(curl -fsSL https://bit.ly/ezpz-utils) && ezpz_setup "${VENV}"
cd "${SUBMIT_DIR}" || exit 9
actual_commit=$(git rev-parse HEAD) || exit 2
[[ "${actual_commit}" == "${EXPECTED_COMMIT}" ]] || exit 2
git diff --quiet && git diff --cached --quiet || exit 2
[[ -s "${MODEL}/model.safetensors" ]] || exit 3
[[ -s "${MODEL}/tokenizer.json" ]] || exit 3
model_sha=$(sha256sum "${MODEL}/model.safetensors" | cut -d' ' -f1)
mkdir -p "${RESULT}"
OUT="${RESULT}/generations.jsonl"
rm -f "${OUT}" "${RESULT}/eval.log"

echo "STAGE3_EVAL_START commit=${actual_commit} model_sha=${model_sha} model=${MODEL}" \
    | tee "${RESULT}/eval.log"
python3 -u torchtitan/experiments/ezpz/scripts/eval/eval_cot_gsm8k.py \
    --model "${MODEL}" --limit 200 --dtype float32 --max-tokens 768 \
    --out "${OUT}" 2>&1 | tee -a "${RESULT}/eval.log"
rc=${PIPESTATUS[0]}
[[ ${rc} -eq 0 ]] || { echo "STAGE3_EVAL_FAILED rc=${rc}"; exit "${rc}"; }
python3 - "${OUT}" <<'PY' || exit 4
import json
import sys
rows = [json.loads(line) for line in open(sys.argv[1]) if line.strip()]
assert len(rows) == 200, len(rows)
correct = sum(bool(row["correct"]) for row in rows)
fmt = sum(bool(row["format_ok"]) for row in rows)
unclosed = sum(row["finish_reason"] == "length" for row in rows)
print(f"STAGE3_EVAL_ROWS rows=200 correct={correct} format={fmt} unclosed={unclosed}")
PY
echo "STAGE3_EVAL_DONE"
