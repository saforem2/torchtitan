#!/bin/bash --login
#PBS -A datascience
#PBS -N agpt2b-mds154391-sft-smoke
#PBS -l walltime=01:00:00
#PBS -l filesystems=tegu:home
#PBS -l select=2
#PBS -q workq
#PBS -j oe
set -o pipefail

WT=/lus/tegu/projects/datascience/foremans/projects/saforem2/torchtitan-sync-416e12cb8
V=/lus/tegu/projects/datascience/foremans/venvs/rl-monarch-torch214
MPIEXEC=/opt/cray/pals/1.8/bin/mpiexec
BASE=/lus/tegu/projects/datascience/foremans/artifacts/agpt-2b-mds-stage3-mix-step154391-hf
PRETOK=/tegu/datasets/datasets/agpt2b-b3-instruct-cot-mix-len8192
OUT=/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-mds154391-b3-sft-smoke
EXPECTED_MODEL_SHA=df4a7289d4eddb57c380d14ceb4c510d7ee6c55b5b79a7ef0f96a3a61e644fd1
EXPECTED_CODE_COMMIT=15b2f53302414a6d7516d7a7724b0527abf5f1c3

# The login environment already provides Sunspot's oneAPI compiler module,
# MPICH, Cray PALS, and Cray libfabric. Do not source Intel's standalone
# setvars.sh here: it prepends Intel MPI/libfabric paths and contaminates the
# PALS-launched workers even when the launcher executable itself is correct.
export PATH="$V/bin:/opt/pbs/bin:$PATH"
export PYTHONPATH="$WT${PYTHONPATH:+:$PYTHONPATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ONEAPI_DEVICE_SELECTOR="opencl:gpu;level_zero:gpu"
export CCL_PROCESS_LAUNCHER=pmix
export CCL_OP_SYNC=1
export CCL_ZE_CACHE_GET_IPC_HANDLES_THRESHOLD=8000
export CCL_ZE_CACHE_OPEN_IPC_HANDLES_THRESHOLD=8000
export TORCH_CPP_LOG_LEVEL=ERROR
# Twelve ranks share each node. Prevent OpenMP/BLAS/tokenizer libraries and
# per-rank dataset preprocessing from each spawning a full-node thread pool.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 WANDB_MODE=disabled
export HF_HOME=/tegu/datasets/datasets/hf
export HF_DATASETS_CACHE=/tegu/datasets/datasets/hf/datasets
export EZPZ_SFT_MIX_CACHE_DIR=/tegu/datasets/datasets/ezpz_sft_mixes
export PYTHONIOENCODING="ascii:replace"
export TMPDIR=/lus/tegu/projects/datascience/foremans/tmp/mds154391-sft-${PBS_JOBID%%.*}
mkdir -p "$TMPDIR" "$OUT"
cd "$WT" || exit 11

commit=$(git rev-parse HEAD)
model_sha=$(sha256sum "$BASE/model-00001-of-00001.safetensors" | cut -d' ' -f1)
git merge-base --is-ancestor "$EXPECTED_CODE_COMMIT" "$commit" || {
  echo "required code commit $EXPECTED_CODE_COMMIT is not in $commit"; exit 12;
}
[[ "$model_sha" == "$EXPECTED_MODEL_SHA" ]] || { echo "bad model sha $model_sha"; exit 13; }
[[ -f "$PRETOK/state.json" ]] || { echo "missing dataset $PRETOK"; exit 14; }
[[ -x "$MPIEXEC" ]] || { echo "missing PALS launcher $MPIEXEC"; exit 15; }
[[ ! -e "$V/bin/mpiexec" ]] || {
  echo "refusing venv-provided mpiexec: $V/bin/mpiexec"; exit 16;
}

echo "MDS154391_SFT_START $(date -Is) commit=$commit model_sha=$model_sha"
# Pin the site PALS launcher. A pip-installed impi-rt injects Intel Hydra,
# Intel libmpi, and Intel libfabric into the venv; that mixed stack fails in
# MPI_Init_thread/open_fabric on Sunspot. Importing ezpz in the PBS parent is
# also invalid because it initializes mpi4py before PALS establishes ranks.
"$MPIEXEC" --version
"$MPIEXEC" -n 24 -ppn 12 --cpu-bind none \
  "$V/bin/python" -c \
  'from mpi4py import MPI; v=MPI.Get_library_version(); assert "MPICH" in v and "Intel(R) MPI" not in v, v; print(f"MPI_PREFLIGHT rank={MPI.COMM_WORLD.rank} size={MPI.COMM_WORLD.size} host={MPI.Get_processor_name()}")' \
  || exit 17

"$MPIEXEC" -n 24 -ppn 12 --cpu-bind none \
  "$V/bin/python" -u -m torchtitan.experiments.ezpz.rl.train_sft \
  --pretokenized_dataset "$PRETOK" \
  --model_name_or_path "$BASE" \
  --output_dir "$OUT" \
  --max_steps 20 \
  --num_train_epochs 1 \
  --learning_rate 2e-5 \
  --per_device_train_batch_size 1 \
  --gradient_accumulation_steps 8 \
  --dataset_num_proc 1 \
  --max_train_samples 4096 \
  --max_length 8192 \
  --bf16 --fsdp full_shard \
  --logging_steps 1 \
  --save_strategy steps --save_steps 10 \
  --report_to none
rc=$?
echo "MDS154391_SFT_DONE rc=$rc $(date -Is)"
exit "$rc"
