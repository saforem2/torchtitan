+def _llama3_rl_model_registry(
+    flavor: str,
+    *,
+    attn_backend: str,
+    converters: list[ModelConfigConverter.Config] | None = None,
+) -> ModelSpec:
+    """``llama3.model_registry`` for RL, with the lm_head fp32 cast always on.
+
+    Mirror of ``_qwen3_rl_model_registry`` for Llama-architecture checkpoints
+    (e.g. AuroraGPT-2B). RL logprob / KL math needs fp32 lm_head logits, so
+    every RL config runs ``LMHeadCastConverter`` on top of whatever it passes.
+    """
+    converters = list(converters or [])
+    converters.append(LMHeadCastConverter.Config())
+    return llama3_model_registry(
+        flavor, attn_backend=attn_backend, converters=converters
+    )
+
