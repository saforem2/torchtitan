#!/bin/bash
#PBS -A datascience
#PBS -l walltime=00:40:00
#PBS -l select=1
#PBS -l filesystems=tegu:home
#PBS -q workq
#PBS -j oe
#PBS -N b3-diag
set -o pipefail
REPO=/lus/tegu/projects/datascience/foremans/projects/saforem2/torchtitan
cd "$REPO" || exit 9

source /usr/share/lmod/lmod/init/bash 2>/dev/null
module load oneapi/release/2025.3.1 hdf5 pti-gpu >/dev/null 2>&1
export CCL_ROOT=/opt/aurora/26.26.0/oneapi/ccl/latest
export LD_LIBRARY_PATH=/opt/cray/libfabric/2.3.1/lib64:/opt/aurora/26.26.0/oneapi/2025.3/opt/mpi/libfabric/lib:$CCL_ROOT/lib:/opt/aurora/26.26.0/oneapi/2025.3/lib:$LD_LIBRARY_PATH
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export ONEAPI_DEVICE_SELECTOR="opencl:gpu;level_zero:gpu"
export ZE_AFFINITY_MASK=0
export ZES_ENABLE_SYSMAN=1
export TORCHINDUCTOR_MAX_AUTOTUNE=0 VLLM_ENABLE_V1_MULTIPROCESSING=1
export HF_DATASETS_OFFLINE=1 HF_HUB_OFFLINE=1
export PATH="/opt/pbs/bin:$PATH"

CKPT=$REPO/outputs/sft/agpt2b-b3-instruct-cot-mix-8n/checkpoint-3605
BASE=$REPO/outputs/sft/aurora2b-sophiag-tulu-mix-32n-gbs6144/checkpoint-729-hf
TOK_SRC=$HOME/rl-repro/run/agpt2b-ckpt900
HF=$REPO/outputs/evals/cot/b3-3605-hf-diag
VENV_MAIN=$REPO/.venv/bin
PY=$REPO/venvs/rl-vllm/bin/python

echo "B3-DIAG START $(date +%T) host=$(hostname)"

# --- consolidate to PERSISTENT path ---
if [[ -f "${HF}/model.safetensors" || -f "${HF}/model-00001-of-00001.safetensors" ]]; then
    echo "[consolidate] ${HF} exists, skip"
else
    echo "[consolidate] ${CKPT} -> ${HF}"
    source "$REPO/.venv/bin/activate"
    accelerate merge-weights "${CKPT}/pytorch_model_fsdp_0" "${HF}" 2>&1 | tail -5
    [[ -f "${BASE}/config.json" && ! -f "${HF}/config.json" ]] && cp "${BASE}/config.json" "${HF}/"
    for f in tokenizer.json tokenizer.model tokenizer_config.json special_tokens_map.json; do
        [[ -f "${TOK_SRC}/${f}" ]] && cp "${TOK_SRC}/${f}" "${HF}/"
    done
    "${VENV_MAIN}/python" torchtitan/experiments/ezpz/scripts/eval/fix_ckpt_eos.py "${HF}"
    deactivate 2>/dev/null || true
fi
echo "[consolidate] listing:"
ls -la "${HF}" | grep -E "safetensors|config.json|tokenizer_config|generation_config"
echo "[consolidate] config eos check:"
"${VENV_MAIN}/python" -c "import json;c=json.load(open(\"${HF}/config.json\"));print(\"eos=\",c[\"eos_token_id\"],\"bos=\",c[\"bos_token_id\"],\"vocab=\",c[\"vocab_size\"],\"arch=\",c[\"architectures\"])"

# --- raw generation probe ---
echo "B3-DIAG PROBE $(date +%T)"
cp /tmp/b3_probe_gen.py "$REPO/b3_probe_gen.py"
"$PY" -u "$REPO/b3_probe_gen.py" "${HF}" 5
echo "B3-DIAG EXIT rc=$? $(date +%T)"
