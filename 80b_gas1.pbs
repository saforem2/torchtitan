#!/bin/bash -l
#PBS -A datascience
#PBS -q workq
#PBS -l select=1:ncpus=208:host=x1921c1s5b0n0+1:ncpus=208:host=x1921c1s7b0n0+1:ncpus=208:host=x1921c2s1b0n0+1:ncpus=208:host=x1921c2s2b0n0+1:ncpus=208:host=x1921c2s3b0n0+1:ncpus=208:host=x1921c2s4b0n0+1:ncpus=208:host=x1921c2s5b0n0+1:ncpus=208:host=x1921c2s6b0n0+1:ncpus=208:host=x1921c2s7b0n0+1:ncpus=208:host=x1921c3s1b0n0+1:ncpus=208:host=x1921c3s2b0n0+1:ncpus=208:host=x1921c3s3b0n0+1:ncpus=208:host=x1921c3s4b0n0+1:ncpus=208:host=x1921c3s5b0n0+1:ncpus=208:host=x1921c3s6b0n0+1:ncpus=208:host=x1921c3s7b0n0+1:ncpus=208:host=x1921c4s2b0n0+1:ncpus=208:host=x1921c4s3b0n0+1:ncpus=208:host=x1921c4s4b0n0+1:ncpus=208:host=x1921c4s5b0n0+1:ncpus=208:host=x1921c4s6b0n0+1:ncpus=208:host=x1921c4s7b0n0+1:ncpus=208:host=x1921c5s0b0n0+1:ncpus=208:host=x1921c5s1b0n0+1:ncpus=208:host=x1921c5s2b0n0+1:ncpus=208:host=x1921c5s3b0n0+1:ncpus=208:host=x1921c5s4b0n0+1:ncpus=208:host=x1921c5s5b0n0+1:ncpus=208:host=x1921c5s6b0n0+1:ncpus=208:host=x1921c5s7b0n0+1:ncpus=208:host=x1921c6s0b0n0+1:ncpus=208:host=x1921c6s1b0n0+1:ncpus=208:host=x1921c6s2b0n0+1:ncpus=208:host=x1921c6s3b0n0+1:ncpus=208:host=x1921c6s4b0n0+1:ncpus=208:host=x1921c6s5b0n0+1:ncpus=208:host=x1921c6s7b0n0+1:ncpus=208:host=x1921c7s0b0n0+1:ncpus=208:host=x1921c7s1b0n0+1:ncpus=208:host=x1921c7s3b0n0+1:ncpus=208:host=x1921c7s5b0n0+1:ncpus=208:host=x1921c7s6b0n0+1:ncpus=208:host=x1921c7s7b0n0+1:ncpus=208:host=x1922c0s0b0n0+1:ncpus=208:host=x1922c0s1b0n0+1:ncpus=208:host=x1922c0s2b0n0+1:ncpus=208:host=x1922c0s3b0n0+1:ncpus=208:host=x1922c0s4b0n0+1:ncpus=208:host=x1922c0s5b0n0+1:ncpus=208:host=x1922c0s7b0n0+1:ncpus=208:host=x1922c1s0b0n0+1:ncpus=208:host=x1922c1s1b0n0+1:ncpus=208:host=x1922c3s2b0n0+1:ncpus=208:host=x1922c3s3b0n0+1:ncpus=208:host=x1922c3s4b0n0+1:ncpus=208:host=x1922c3s5b0n0+1:ncpus=208:host=x1922c3s6b0n0+1:ncpus=208:host=x1922c3s7b0n0+1:ncpus=208:host=x1922c4s0b0n0+1:ncpus=208:host=x1922c4s2b0n0+1:ncpus=208:host=x1922c4s3b0n0+1:ncpus=208:host=x1922c4s4b0n0+1:ncpus=208:host=x1922c4s5b0n0+1:ncpus=208:host=x1922c4s6b0n0
#PBS -l walltime=06:00:00
#PBS -l filesystems=tegu
#PBS -N 80b-gas1
#PBS -j oe
#
# GAS=1 ARM: separates data parallelism from gradient accumulation.
#
# THE CONFOUND. Every arm so far held GBS fixed at 384 seqs, and
# GBS = 4096 * dp * GAS, so dp and GAS moved together and inversely:
#     dp= 48 GAS=8   dp= 96 GAS=4   dp=192 GAS=2
# So "skew scales with dp" is, strictly, "skew scales with dp-and-inverse-GAS".
# The dp=192 arm is also the one whose runner-up layers sit at index ~10 while
# dp=48/96 sit at ~40 -- equally consistent with "GAS=2 is different".
#
# THE SEPARATION. Hold dp FIXED at 192 (64N, unchanged from 12474803) and move
# GAS 2 -> 1. GBS necessarily halves to 192 seqs. That is fine, because the GBS
# experiment (12474765 vs 12474768, 16x apart) established that GBS moves
# VARIANCES by sqrt(N) and leaves MEANS invariant to 0.03-0.20%. So:
#
#   a MEAN shift here is attributable to GAS, not to the batch change
#   a VARIANCE shift is expected (sqrt(2) from halving GBS) and is not evidence
#
# PREDICTIONS, recorded before the run:
#   If skew is really about dp: skew stays ~273 (dp unchanged).
#   If skew is really about GAS: skew moves, and the direction says which way
#     the accumulation count matters.
#   Runner-up layer index ~10 persisting at GAS=1 points at dp; reverting to
#     ~40 points at GAS.
#
# Cheap: 64N at 192 seqs is ~1 min/step, so 40 steps is well under an hour.
# Everything else held: seed 42, SophiaG, peak 5.376344e-09 with warmup 25,
# TP=4, access-verified hosts.

REPO=/lus/tegu/projects/datascience/foremans/projects/saforem2/torchtitan
cd "$REPO" || exit 1

export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
export no_proxy=localhost,127.0.0.1,*.alcf.anl.gov
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export PYTORCH_XPU_ALLOC_CONF=expandable_segments:True
export CCL_LOG_LEVEL=ERROR
export EZPZ_DIAG_ECHO=1
module use /opt/aurora/26.181.0/modulefiles >/dev/null 2>&1
module load frameworks/2026.1.0 >/dev/null 2>&1
# -rc2-grain, NOT -rc2: the post-#4088 dataloader imports grain.python.
export PATH="$REPO/venvs/fw-2026.1-rc2-grain/bin:$PATH"; unset PYTHONPATH
source "$REPO/venvs/fw-2026.1-rc2-grain/bin/activate" 2>/dev/null
python3 -c "import torch;print('torch',torch.__version__)" 2>&1 | tail -1

export LOGD="$REPO/outputs/logs/80b-gas1/$PBS_JOBID"; mkdir -p "$LOGD"
LOG="$LOGD/capture.log"

# Derived from the flags actually passed below, not hardcoded. Every variant
# of this script inherited a banner reading "GBS 6144 via GAS=32 at dp=192"
# from the first 64N version and printed it regardless of what it ran -- so
# 12474768, a 384-seq run at dp=96, announced itself as a 6144-seq run at
# dp=192. A log header that lies is worse than none.
_lr=$(grep -oE "optimizer-kwargs.lr=[0-9.e-]+" "$0" | head -1 | cut -d= -f2)
_tok=$(grep -oE "num-tokens-per-train-step=[0-9]+" "$0" | head -1 | cut -d= -f2)
_np=$(grep -oE "nproc [0-9]+" "$0" | head -1 | awk "{print \$2}")
_tp=$(grep -oE "tensor-parallel-degree=[0-9]+" "$0" | head -1 | cut -d= -f2)
_dp=$(( _np / _tp ))
_gas=$(( _tok / 4096 / _dp ))
echo "reproducing 8574385: sophiag lr=$_lr, $(( _tok / 4096 )) seqs via GAS=$_gas at dp=$_dp"
#
# INNER TIMEOUT MUST TRACK THE WALLTIME. 2026-09-06. This was `timeout 12000`
# -- 3h20m -- carried over from the 4h version of this script while the PBS
# walltime above says 12h. The inner timeout wins, so 12474740 exited
# Exit_status=0 at exactly 03:20:41 after 5 steps, having been given 12 hours,
# and its step-19 target was never reachable. A clean exit code and a full
# step log make that look like a completed run rather than a truncated one.
#
# 84600s = 23h30m of a 24h wall (the queue max), leaving ~30 min for init and
# the analysis block.
#
# WHY NOT 12h. Measured from 12474733/12474740: ~35 min from job start to step
# 1, then ~34 min per step. A 11h30m timeout buys 19.3 steps against a step-18
# target -- ONE step of margin. A slow init, a straggler rank, or a single
# long step and an 11-hour run misses the only point it exists to reach.
# 23h30m buys ~40 steps, so step 18 lands with the run less than half spent.
timeout 19800 ezpz launch --nproc 768 -ppn 12 -- \
  python3 -m torchtitan.experiments.ezpz.train \
    --module ezpz.agpt --config agpt_80b_sophiag \
    --training.steps=40 \
    --training.max-context-length=4096 \
    --training.num-tokens-per-microbatch-per-dp-rank=4096 \
    --training.num-tokens-per-train-step=786432 \
    --parallelism.tensor-parallel-degree=4 \
    --optimizer.param-groups.0.optimizer-kwargs.lr=5.376344e-09 \
    --lr-scheduler.warmup-steps=25 \
    --lr-scheduler.decay-ratio=0 \
    --compile.no-enable \
    --diagnostics --diagnostics-attention \
    --diagnostics-per-layer --diagnostics-interval=1 \
    --checkpoint.no-enable \
    --debug.seed=42 \
    > "$LOG" 2>&1
echo "  rc=$?"

echo ""
echo "########## which tensor went non-finite? ##########"
LOG="$LOG" python3 - <<'PY'
import os, re

log = os.environ["LOG"]
ansi = re.compile(r"\x1b\[[0-9;]*m")
txt = ansi.sub("", open(log, errors="replace").read()) if os.path.exists(log) else ""

lr = (re.findall(r'"lr": *([0-9.e+-]+)', txt) or ["?"])[0]
gas = (re.findall(r"gradient accumulation steps (\d+)", txt) or ["?"])[0]
tok = (re.findall(r"tokens/train-step (\d+)", txt) or ["?"])[0]
opt = (re.findall(r'"optimizer_name": *"([A-Za-z]+)"', txt) or ["?"])[0]
rows = re.findall(r"step: *(\d+) +loss: *([0-9.]+|nan|inf) +grad_norm: *([0-9.]+|nan|inf)", txt)
events = re.findall(r"non-finite grad_norm \([^)]*\) at step (\d+)", txt)

print(f"  optimizer {opt}   lr {lr}   GAS {gas}   tokens/step {tok}")
print(f"  (target: SophiaG, 5.376344e-09 w/ warmup 25, 1, 786432) at dp=192")
print(f"  steps {len(rows)}   non-finite events {len(events)}"
      f"{' at ' + ','.join(events[:8]) if events else ''}")

# the capture lines -- this is the payload
named = re.findall(
    r"NON-FINITE GRADIENT CAPTURE step (\d+): metrics that are THEMSELVES "
    r"non-finite[^:]*: ([^\n]+)", txt)
print()
if named:
    print("  THE ANSWER -- tensors whose metrics went non-finite:")
    for st, which in named[:5]:
        print(f"    step {st}: {which}")
else:
    dumps = re.findall(r"NON-FINITE GRADIENT CAPTURE step (\d+): (diag/[^\n]+)", txt)
    if dumps:
        print("  Capture fired but named no non-finite METRIC. Full stats at the"
              " event (the aggregate went non-finite without any per-layer")
        print("  metric doing so -- itself informative):")
        for st, d in dumps[:2]:
            print(f"    step {st}: {d[:300]}")
    else:
        print("  Capture did NOT fire.")

print()
if lr not in ("5.376344e-09", "5.376344e-9", "5.3763e-09"):
    print("  VOID: lr is not 5.376344e-09, so the rescaled trajectory")
    print("  does not match 8574385 step for step.")
elif tok != "786432":
    print(f"  VOID: tokens/step {tok} != 786432, so GAS is not 1."
          " calibration.")
elif not rows:
    print("  No steps. Read the log.")
elif not events:
    print("  DID NOT REPRODUCE: 40 steps, zero non-finite gradients, where")
    print("  8574385 died at step 18. Since LR, optimizer and GBS all match,")
    print("  the difference is SCALE (192 dp here vs 510N/dp~1275 there) --")
    print("  which contradicts the 'GAS compensates for node count' assumption")
    print("  the original bracket was designed around. That is a real finding.")
elif named:
    print("  REPRODUCED AND LOCALIZED. The tensors above are the first direct")
    print("  evidence of WHERE the 80B failure originates, as opposed to")
    print("  inference from which configuration survived.")
else:
    print("  REPRODUCED but not localized -- see the capture output above.")
PY
echo "CAPTURE_DONE"
